    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.3rem;
}

.team-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
}

/* --- KONTAKT A FORMULÁŘ --- */
.contact-container {
    margin: 0 var(--side) clamp(2.5rem, 4vw, 4.5rem);
