}

.service-card:hover .card-more i {
    transform: translateX(4px);
}

.card-more i {
    transition: var(--transition);
}

/* --- JAK PRACUJEME --- */
.steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.2rem, 2vw, 2rem);
}

.step-num {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--brand-blue);
    color: white;
    font-weight: 800;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.1rem;
    box-shadow: 0 4px 15px var(--brand-blue-glow);
}

.step h4 {
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
}

.step p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
}

/* --- REFERENCE / POROVNÁVAČ --- */
.case-study {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
}

.case-tag {
    display: inline-block;
    background: rgba(0, 86, 210, 0.25);
    color: #60a5fa;
    border: 1px solid rgba(0, 86, 210, 0.4);
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.8rem;
    margin-bottom: 1.2rem;
    width: fit-content;
}

.before-after-container {
    position: relative;
    width: 100%;
    height: clamp(280px, 30vw, 420px);
    border-radius: 20px;
    overflow: hidden;
    user-select: none;
    touch-action: pan-y;
    background: #283548;
    border: 1px solid var(--border-card);
    cursor: ew-resize;
}

.ba-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
}

.ba-before {
    background-image: url('Pred.JPG');
    width: 50%;
    z-index: 2;
    border-right: 3px solid white;
    box-shadow: 5px 0 20px rgba(0, 0, 0, 0.3);
}

.ba-after {
    background-image: url('Po.JPEG');
    z-index: 1;
}

.ba-label {
    position: absolute;
    bottom: 15px;
    padding: 6px 14px;
    background: rgba(17, 24, 39, 0.85);
    color: white;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 3;
    transform: translateX(-50%);
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.2s ease-out;
}

.ba-label-before { left: 25%; }
.ba-label-after { left: 75%; }

.ba-slider-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: white;
    border-radius: 50%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-blue);
    font-size: 1.1rem;
}

/* --- KARTY PROJEKTŮ --- */
.project-card {
    background: var(--card-dark);
    border-radius: clamp(18px, 2vw, 24px);
    border: 1px solid var(--border-card);
    overflow: hidden;
    color: white;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
}

.project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 86, 210, 0.25);
    border-color: rgba(0, 86, 210, 0.5);
}

/* Když fotka chybí, zobrazí se ikona */
.project-img {
    position: relative;
    height: 210px;
    background: linear-gradient(135deg, #283548 0%, #1a2436 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(96, 165, 250, 0.45);
    font-size: 3rem;
    border-bottom: 1px solid var(--border-card);
}

.project-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.project-body {
    padding: clamp(1.5rem, 2.2vw, 2rem);
    display: flex;
    flex-direction: column;
    flex: 1;
}

.project-body .case-tag {
    margin-bottom: 0.9rem;
}

.project-body h3 {
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    font-weight: 700;
    margin-bottom: 0.7rem;
    line-height: 1.3;
}

.project-body p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
}

/* --- O NÁS --- */
.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
}

.about-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

.about-feature-item {
    background: var(--card-inner);
    padding: 1.2rem;
    border-radius: 16px;
    border: 1px solid var(--border-card);
}

.about-feature-item i {
    color: #60a5fa;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    display: block;
}

.about-feature-item h4 {
    color: white;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
}

.about-feature-item p {
    color: var(--text-muted);
    font-size: 0.85rem;
}

/* --- TÝM --- */
.team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

.team-card {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    background: var(--card-inner);
    border: 1px solid var(--border-card);
    border-radius: 18px;
    padding: 1.6rem 1.8rem;
}

.team-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-blue) 0%, #3b82f6 100%);
