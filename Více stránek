    align-items: center;
    justify-content: center;
    color: rgba(96, 165, 250, 0.45);
    font-size: 3rem;
    border-bottom: 1px solid var(--border-card);
}

.project-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.project-body {
    padding: clamp(1.5rem, 2.2vw, 2rem);
    display: flex;
    flex-direction: column;
    flex: 1;
}

.project-body .case-tag {
