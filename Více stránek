    display: flex;
    align-items: center;
    padding: calc(var(--header-height) + 2rem) var(--side) 4rem;
    overflow: hidden;
    margin-bottom: 2rem;
}

.hero-content {
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    animation: fadeInUp 0.8s ease-out;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 86, 210, 0.2);
    border: 1px solid rgba(0, 86, 210, 0.5);
    color: #60a5fa;
    padding: 6px 16px;
    border-radius: 30px;
    font-size: clamp(0.75rem, 1vw, 0.9rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
}

.hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -1px;
}

.hero h1 span,
.page-hero h1 span {
    color: #3b82f6;
}

.hero p {
    font-size: clamp(1rem, 1.3vw, 1.35rem);
    color: #cbd5e1;
    margin-bottom: 2.5rem;
    max-width: 750px;
}

.hero-btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.hero-btn {
    padding: 1rem 2.2rem;
    font-size: 1rem;
    color: white;
    border-radius: 50px;
    text-decoration: none;
    text-align: center;
    transition: var(--transition);
}

.hero-btn-primary {
    background: var(--brand-blue);
    font-weight: 700;
    box-shadow: 0 4px 15px var(--brand-blue-glow);
}

.hero-btn-primary:hover {
    background: var(--brand-blue-hover);
    transform: translateY(-2px);
}

.hero-btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-weight: 600;
}

.hero-btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
}

.hero-stats {
    display: flex;
    gap: clamp(1.5rem, 3vw, 4rem);
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.stat-item h3 {
    font-size: clamp(1.8rem, 2.5vw, 2.8rem);
    font-weight: 800;
    color: #3b82f6;
}

.stat-item p {
    font-size: clamp(0.8rem, 1vw, 1rem);
    color: #cbd5e1;
    margin: 0;
}

/* --- ZÁHLAVÍ PODSTRÁNEK --- */
.page-hero {
    padding: calc(var(--header-height) + clamp(3rem, 6vw, 5rem)) var(--side) clamp(3rem, 5vw, 4.5rem);
    text-align: center;
    margin-bottom: 1rem;
}

.page-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    animation: fadeInUp 0.8s ease-out;
}

.page-hero h1 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.15;
    margin-bottom: 0.9rem;
}

.page-hero p {
    color: #cbd5e1;
    max-width: 680px;
    margin: 0 auto;
    font-size: clamp(1rem, 1.2vw, 1.2rem);
}

/* --- SEKČNÍ HLAVIČKY --- */
.section-header {
    text-align: center;
    max-width: 750px;
    margin: clamp(2.5rem, 5vw, 4.5rem) auto clamp(1.8rem, 3vw, 3rem) auto;
    padding: 0 1rem;
}

.section-subtitle {
    color: var(--brand-blue);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: clamp(0.75rem, 1vw, 0.9rem);
    margin-bottom: 0.5rem;
    display: block;
}

.section-title {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
}

.section-lead {
    color: #475569;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    margin-top: 0.8rem;
}

/* --- TMAVÉ DLAŽDICE --- */
.dark-card-container {
    background: var(--card-dark);
    border-radius: clamp(18px, 2.5vw, 28px);
    padding: clamp(2rem, 4vw, 4.5rem) clamp(1.5rem, 4vw, 4.5rem);
    color: white;
    box-shadow: 0 20px 40px rgba(17, 24, 39, 0.08);
    border: 1px solid var(--border-card);
    margin: 0 var(--side) clamp(2.5rem, 4vw, 4.5rem);
}

.card-title {
    font-size: clamp(1.4rem, 2vw, 2rem);
    margin-bottom: 1rem;
    color: white;
    line-height: 1.25;
}

.card-text {
    color: var(--text-muted);
    margin-bottom: 1.2rem;
    font-size: clamp(0.9rem, 1vw, 1.05rem);
    line-height: 1.7;
}

.check-list {
    list-style: none;
}

.check-list li {
    margin-bottom: 10px;
    color: #e2e8f0;
    font-weight: 600;
    font-size: clamp(0.85rem, 1vw, 1rem);
    display: flex;
    gap: 10px;
    align-items: baseline;
}

.check-list li i {
    color: #60a5fa;
}

/* --- VÝZVA K AKCI --- */
.cta-band {
    text-align: center;
}

.cta-band h2 {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    font-weight: 800;
    margin-bottom: 0.6rem;
    line-height: 1.25;
}

.cta-band p {
    color: var(--text-muted);
    max-width: 620px;
    margin: 0 auto 1.8rem;
}

.cta-band .hero-btns {
    justify-content: center;
}

/* --- KARTY SLUŽEB --- */
.services-grid,
.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(clamp(280px, 25vw, 380px), 1fr));
    gap: clamp(1.2rem, 2vw, 2.2rem);
    margin: 0 var(--side) clamp(2.5rem, 4vw, 4.5rem);
}

.service-card {
    background: var(--card-dark);
    padding: clamp(2rem, 3vw, 3.2rem) clamp(1.5rem, 2.5vw, 2.5rem);
    border-radius: clamp(18px, 2vw, 24px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
    border: 1px solid var(--border-card);
    transition: var(--transition);
    color: white;
    display: flex;
    flex-direction: column;
    text-decoration: none;
}

.service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 86, 210, 0.25);
    border-color: rgba(0, 86, 210, 0.5);
}

.service-icon {
    width: clamp(50px, 4vw, 65px);
    height: clamp(50px, 4vw, 65px);
    background: rgba(0, 86, 210, 0.2);
    color: #60a5fa;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    margin-bottom: 1.8rem;
    border: 1px solid rgba(0, 86, 210, 0.3);
    transition: var(--transition);
}

.service-card:hover .service-icon {
    background: var(--brand-blue);
    color: white;
    transform: scale(1.05);
}

.service-card h3 {
    font-size: clamp(1.2rem, 1.5vw, 1.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: white;
}

.service-card p {
    color: var(--text-muted);
    font-size: clamp(0.9rem, 1vw, 1.05rem);
    line-height: 1.7;
}

/* Odkaz „Zobrazit více“ na kartách rozcestníku */
.card-more {
    margin-top: auto;
    padding-top: 1.4rem;
    color: #60a5fa;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.service-card:hover .card-more i {
    transform: translateX(4px);
}

.card-more i {
    transition: var(--transition);
}

/* --- JAK PRACUJEME --- */
.steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.2rem, 2vw, 2rem);
}

.step-num {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--brand-blue);
    color: white;
    font-weight: 800;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.1rem;
    box-shadow: 0 4px 15px var(--brand-blue-glow);
}

.step h4 {
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
}

.step p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
}

/* --- REFERENCE / POROVNÁVAČ --- */
.case-study {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
}

.case-tag {
    display: inline-block;
    background: rgba(0, 86, 210, 0.25);
    color: #60a5fa;
    border: 1px solid rgba(0, 86, 210, 0.4);
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.8rem;
    margin-bottom: 1.2rem;
    width: fit-content;
}

.before-after-container {
    position: relative;
    width: 100%;
    height: clamp(280px, 30vw, 420px);
    border-radius: 20px;
    overflow: hidden;
    user-select: none;
    touch-action: pan-y;
    background: #283548;
    border: 1px solid var(--border-card);
    cursor: ew-resize;
}

.ba-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
}

.ba-before {
    background-image: url('Pred.JPG');
    width: 50%;
    z-index: 2;
    border-right: 3px solid white;
    box-shadow: 5px 0 20px rgba(0, 0, 0, 0.3);
}

.ba-after {
    background-image: url('Po.JPEG');
    z-index: 1;
}

.ba-label {
    position: absolute;
    bottom: 15px;
    padding: 6px 14px;
    background: rgba(17, 24, 39, 0.85);
    color: white;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 3;
    transform: translateX(-50%);
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.2s ease-out;
}

.ba-label-before { left: 25%; }
.ba-label-after { left: 75%; }

.ba-slider-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: white;
    border-radius: 50%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-blue);
    font-size: 1.1rem;
}

/* --- KARTY PROJEKTŮ --- */
.project-card {
    background: var(--card-dark);
    border-radius: clamp(18px, 2vw, 24px);
    border: 1px solid var(--border-card);
    overflow: hidden;
    color: white;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
}

.project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 86, 210, 0.25);
    border-color: rgba(0, 86, 210, 0.5);
}

/* Když fotka chybí, zobrazí se ikona */
.project-img {
    position: relative;
    height: 210px;
    background: linear-gradient(135deg, #283548 0%, #1a2436 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(96, 165, 250, 0.45);
    font-size: 3rem;
    border-bottom: 1px solid var(--border-card);
}

.project-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.project-body {
    padding: clamp(1.5rem, 2.2vw, 2rem);
    display: flex;
    flex-direction: column;
    flex: 1;
}

.project-body .case-tag {
    margin-bottom: 0.9rem;
}

.project-body h3 {
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    font-weight: 700;
    margin-bottom: 0.7rem;
    line-height: 1.3;
}

.project-body p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
}

/* --- O NÁS --- */
.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
}

.about-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

.about-feature-item {
    background: var(--card-inner);
    padding: 1.2rem;
    border-radius: 16px;
    border: 1px solid var(--border-card);
}

.about-feature-item i {
    color: #60a5fa;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    display: block;
}

.about-feature-item h4 {
    color: white;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
}

.about-feature-item p {
    color: var(--text-muted);
    font-size: 0.85rem;
}

/* --- TÝM --- */
.team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

.team-card {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    background: var(--card-inner);
    border: 1px solid var(--border-card);
    border-radius: 18px;
    padding: 1.6rem 1.8rem;
}

.team-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-blue) 0%, #3b82f6 100%);
    color: white;
    font-weight: 800;
    font-size: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
}

.team-avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.team-card h4 {
    color: white;
    font-size: 1.15rem;
    font-weight: 700;
}

.team-role {
    color: #60a5fa;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.3rem;
}

.team-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
}

/* --- KONTAKT A FORMULÁŘ --- */
.contact-container {
    margin: 0 var(--side) clamp(2.5rem, 4vw, 4.5rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: stretch;
}

.contact-info-box,
.contact-form-box {
    background: var(--card-dark);
    border-radius: clamp(18px, 2.5vw, 28px);
    padding: clamp(2rem, 3.5vw, 3.5rem);
    color: white;
    border: 1px solid var(--border-card);
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 20px 40px rgba(17, 24, 39, 0.08);
}

.contact-info-card {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.2rem;
}

.contact-label {
    color: var(--text-muted);
    font-size: 0.85rem;
}

.contact-info-card a {
    color: white;
    font-weight: 700;
    text-decoration: none;
    font-size: clamp(1.05rem, 1.2vw, 1.25rem);
}

.contact-icon {
    width: 50px;
    height: 50px;
    background: rgba(0, 86, 210, 0.2);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    color: #60a5fa;
    border: 1px solid rgba(0, 86, 210, 0.4);
    flex-shrink: 0;
}

.company-info {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.company-info strong {
    display: block;
    margin-bottom: 0.3rem;
    color: #f1f5f9;
    font-weight: 600;
}

.company-info p {
    color: var(--text-muted);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 8px;
}

.company-info i {
    color: #60a5fa;
}

.contact-form-box h3 {
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-weight: 800;
    margin-bottom: 0.4rem;
}

.contact-form-box > p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.8rem;
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-group label {
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 700;
}

.form-group input,
.form-group textarea {
    width: 100%;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 0.95rem 1.1rem;
    color: #0f172a;
    font-size: 0.95rem;
    transition: var(--transition);
    outline: none;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: #64748b;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: #0056d2;
    box-shadow: 0 0 0 4px rgba(0, 86, 210, 0.2);
}

.form-group textarea {
    resize: vertical;
    min-height: 140px;
}

.submit-btn {
    background: var(--brand-blue);
    color: #ffffff;
    border: none;
    padding: 1rem 1.8rem;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: 0 4px 15px var(--brand-blue-glow);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
}

.submit-btn:hover {
    background: var(--brand-blue-hover);
    transform: translateY(-2px);
}

.submit-btn:disabled {
    cursor: not-allowed;
    transform: none;
}

.form-status {
    margin-top: 1rem;
    padding: 0.8rem 1rem;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    display: none;
}

.form-status.error {
    display: block;
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

/* --- PATIČKA --- */
footer {
    background: #0b0f19;
    color: #64748b;
    text-align: center;
    padding: 3rem 2rem 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.9rem;
}

.footer-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.8rem;
    margin-bottom: 1.8rem;
}

.footer-nav a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition);
}

.footer-nav a:hover {
    color: #ffffff;
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 2.2rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.social-icon {
    color: #ffffff;
    font-size: 1.8rem;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    opacity: 0.85;
    width: 30px;
    height: 30px;
}

.social-icon:hover {
    color: #3b82f6;
    transform: translateY(-3px);
    opacity: 1;
}

/* --- ANIMACE --- */
.reveal {
    opacity: 0;
    transform: translateY(30px) scale(0.98);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease-out;
}

.reveal.active {
    opacity: 1;
    transform: none;
}

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: none; }
}

/* ================================================
   RESPONZIVITA
   ================================================ */
@media (min-width: 1441px) {
    .dark-card-container, .services-grid, .projects-grid, .contact-container {
        margin-left: auto;
        margin-right: auto;
        max-width: 1440px;
    }
}

@media (max-width: 1024px) {
    :root {
        --side: 5%;
    }
    .case-study, .about-grid, .contact-container {
        grid-template-columns: 1fr;
    }
    .steps-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    :root {
        --header-height: 80px;
        --side: 4%;
    }

    .logo-img {
        height: clamp(60px, 8vw, 72px);
    }

    .header-cta {
        display: none;
    }

    nav {
        left: 0;
        right: 0;
        width: 100%;
        border-left: none;
        border-right: none;
        border-radius: 0 0 18px 18px;
        padding: 0.6rem 1.5rem 1.5rem;
    }

    .about-features, .team-grid, .steps-grid {
        grid-template-columns: 1fr;
    }

    .hero {
        min-height: auto;
        padding-top: calc(var(--header-height) + 2.5rem);
    }

    .hero-stats {
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .hero-btns {
        flex-direction: column;
        width: 100%;
    }

    .hero-btns a {
        width: 100%;
    }

    .services-grid, .projects-grid {
        grid-template-columns: 1fr;
    }

