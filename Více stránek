    color: #64748b;
    text-align: center;
    padding: 3rem 2rem 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.9rem;
}

.footer-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.8rem;
    margin-bottom: 1.8rem;
