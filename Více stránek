    font-weight: 800;
    font-size: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
}

.team-avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.team-card h4 {
    color: white;
    font-size: 1.15rem;
    font-weight: 700;
}

.team-role {
    color: #60a5fa;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.3rem;
}

.team-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
}

/* --- KONTAKT A FORMULÁŘ --- */
.contact-container {
    margin: 0 var(--side) clamp(2.5rem, 4vw, 4.5rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: stretch;
}

.contact-info-box,
.contact-form-box {
    background: var(--card-dark);
    border-radius: clamp(18px, 2.5vw, 28px);
    padding: clamp(2rem, 3.5vw, 3.5rem);
    color: white;
    border: 1px solid var(--border-card);
