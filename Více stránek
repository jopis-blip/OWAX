    <script>
/* ================================================
   OWAX – společné skripty pro všechny stránky
   ================================================ */

/* === BURGER MENU === */
const hamburgerBtn = document.getElementById('hamburger-btn');
const navMenu = document.getElementById('nav-menu');

function setMenu(open) {
    navMenu.classList.toggle('active', open);
    hamburgerBtn.classList.toggle('active', open);
    hamburgerBtn.setAttribute('aria-expanded', open);
    hamburgerBtn.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');

    const icon = hamburgerBtn.querySelector('i');
    icon.classList.toggle('fa-bars', !open);
    icon.classList.toggle('fa-xmark', open);
}

hamburgerBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenu(!navMenu.classList.contains('active'));
});

// Zavření kliknutím mimo menu
document.addEventListener('click', (e) => {
    if (navMenu.classList.contains('active') && !navMenu.contains(e.target)) {
        setMenu(false);
    }
});

// Zavření klávesou Esc
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
});

/* === REVEAL ANIMACE === */
const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        entry.target.classList.toggle('active', entry.isIntersecting);
    });
}, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

/* === POSUVNÍK PŘED / PO (jen na stránce Reference) === */
const slider = document.getElementById('ba-slider');

if (slider) {
    const beforeImg = document.getElementById('ba-before');
    const handle = document.getElementById('ba-handle');
    const labelBefore = slider.querySelector('.ba-label-before');
    const labelAfter = slider.querySelector('.ba-label-after');

    let isDown = false;
    let ticking = false;

    // Nastaví posuvník na pozici v procentech (0–100)
    function setSliderPercent(percent) {
        percent = Math.min(100, Math.max(0, percent));

        beforeImg.style.width = percent + '%';
        handle.style.left = percent + '%';

        // Popisky drží uprostřed své poloviny
        labelBefore.style.left = (percent / 2) + '%';
        labelAfter.style.left = (percent + (100 - percent) / 2) + '%';

        // U kraje popisky schováme
        labelBefore.style.opacity = percent < 12 ? '0' : '1';
        labelAfter.style.opacity = percent > 88 ? '0' : '1';
    }

    function updateSlider(clientX) {
        const rect = slider.getBoundingClientRect();
        if (!rect.width) return;
        setSliderPercent(((clientX - rect.left) / rect.width) * 100);
    }

    function getClientX(e) {
        if (e.touches && e.touches.length) return e.touches[0].clientX;
        return e.clientX;
    }

    function onMove(e) {
        if (!isDown) return;
        const clientX = getClientX(e);
        if (typeof clientX !== 'number') return;

        if (!ticking) {
            window.requestAnimationFrame(() => {
                updateSlider(clientX);
                ticking = false;
            });
            ticking = true;
        }
    }

    function onStart(e) {
        isDown = true;
        const clientX = getClientX(e);
        if (typeof clientX === 'number') updateSlider(clientX);
    }

    function onEnd() {
        isDown = false;
    }

    slider.addEventListener('mousedown', (e) => {
        e.preventDefault();
        onStart(e);
    });
    slider.addEventListener('touchstart', onStart, { passive: true });
    window.addEventListener('mousemove', onMove);
    slider.addEventListener('touchmove', onMove, { passive: true });
    window.addEventListener('mouseup', onEnd);
    window.addEventListener('touchend', onEnd);
    window.addEventListener('touchcancel', onEnd);

    setSliderPercent(50);
}

/* === ODESÍLÁNÍ FORMULÁŘE (jen na stránce Kontakt) === */
const contactForm = document.getElementById('contact-form');

if (contactForm) {
    const submitBtn = document.getElementById('submit-btn');
    const formStatus = document.getElementById('form-status');

    contactForm.addEventListener('submit', function (e) {
        e.preventDefault();

        const originalBtnHtml = submitBtn.innerHTML;

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Odesílám...';
        formStatus.className = 'form-status';

        fetch(contactForm.action, {
            method: 'POST',
            body: new FormData(contactForm),
            headers: { 'Accept': 'application/json' }
        })
        .then(response => {
            if (!response.ok) throw new Error('Chyba odeslání');

            submitBtn.style.backgroundColor = 'var(--brand-green)';
            submitBtn.style.boxShadow = '0 4px 15px rgba(34, 197, 94, 0.4)';
            submitBtn.innerHTML = '<i class="fa-solid fa-circle-check"></i> Poptávka úspěšně odeslána';
            contactForm.reset();
        })
        .catch(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHtml;
            formStatus.textContent = '✕ Při odesílání došlo k chybě. Zkuste to prosím znovu nebo nám zavolejte.';
            formStatus.className = 'form-status error';
        });
    });
}

