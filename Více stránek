}

.company-info {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.company-info strong {
    display: block;
    margin-bottom: 0.3rem;
    color: #f1f5f9;
    font-weight: 600;
