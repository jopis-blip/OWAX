    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    display: none;
}

.form-status.error {
    display: block;
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
