    border-radius: 16px;
    border: 1px solid var(--border-card);
}

.about-feature-item i {
    color: #60a5fa;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    display: block;
}

.about-feature-item h4 {
    color: white;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
}

.about-feature-item p {
    color: var(--text-muted);
    font-size: 0.85rem;
}

/* --- TÝM --- */
.team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

.team-card {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    background: var(--card-inner);
    border: 1px solid var(--border-card);
    border-radius: 18px;
    padding: 1.6rem 1.8rem;
}

.team-avatar {
    width: 88px;
